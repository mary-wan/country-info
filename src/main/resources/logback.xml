<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd-MM-yyyy HH:mm:ss.SSS} %magenta([%thread]) %clr(%-5level) [%X{correlationId:-}] %logger{36}.%M - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.hibernate.orm.connections.pooling" level="warn"/>
    <logger name="com.example.countryinformation.config.SoapLoggingInterceptor" level="info"/>

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
